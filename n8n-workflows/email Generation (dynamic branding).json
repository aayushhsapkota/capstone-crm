    {
      "parameters": {
        "html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"en\">\n<head>\n    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>{{ $('Generate Email Webhook').item.json.body.ownerProfile.companyName }} - Limited-Time Offer</title>\n    <!-- Basic styles for wide compatibility -->\n    <style type=\"text/css\">\n        body { margin: 0; padding: 0; background-color: #f0f4f8; font-family: 'Arial', sans-serif; }\n        table { border-collapse: collapse; }\n        a { text-decoration: none; }\n        /* Make button background easy to find and update */\n        .button { background-color: #3730a3; border-radius: 8px; }\n        .button a { color: #ffffff; display: block; padding: 14px 28px; text-decoration: none; font-weight: bold; font-size: 16px; }\n\n        /* Responsive Styles */\n        @media only screen and (max-width: 600px) {\n            .main-content { width: 100% !important; }\n            .stack-col { width: 100% !important; display: block !important; padding-left: 0 !important; padding-right: 0 !important; }\n            .offer-text { font-size: 36px !important; }\n            .cta-padding { padding: 30px 20px !important; }\n            .card-spacer { padding-right: 0 !important; padding-left: 0 !important; }\n            .card-container { width: 100% !important; }\n        }\n    </style>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #f0f4f8;\">\n\n    <!-- Outer Table for Email Centering -->\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" role=\"presentation\" style=\"table-layout: fixed;\">\n        <tr>\n            <td align=\"center\" style=\"padding: 20px 0;\">\n\n                <!-- Main Content Wrapper Table (Max Width 600px) -->\n                <table class=\"main-content\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" role=\"presentation\" style=\"background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\">\n\n                    <!-- Header Section (Dark Blue) -->\n                    <tr>\n                        <td align=\"center\" style=\"padding: 30px 0; background-color: #1e3a8a; border-radius: 12px 12px 0 0;\">\n                            <h1 style=\"color: #ffffff; font-size: 26px; margin: 0; line-height: 1.2;\">\n                                <span style=\"font-size: 30px; vertical-align: middle;\">🚀</span>&nbsp;{{ $('Generate Email Webhook').item.json.body.ownerProfile.companyName }}\n                            </h1>\n                        </td>\n                    </tr>\n\n                    <!-- Main Offer Banner (Light Gray Background) -->\n                    <tr>\n                        <td align=\"center\" style=\"padding: 40px 40px 20px 40px; background-color: #f9fafb;\">\n                            <p style=\"color: #3730a3; font-size: 20px; font-weight: 600; margin: 0 0 10px 0;\">\n                                Exclusive Offer\n                            </p>\n                            <!-- NOTE: Easily change the percentage and time period here -->\n                            <h2 class=\"offer-text\" style=\"color: #1e3a8a; font-size: 48px; font-weight: 900; margin: 0;\">\n                         {{ $json.DiscountPercentage }}% OFF FIRST {{ $json.offerPeriod }}\n                            </h2>\n                        </td>\n                    </tr>\n\n                    <!-- Body Content -->\n                    <tr>\n                        <td style=\"padding: 30px 40px 10px 40px; color: #374151; font-size: 16px; line-height: 1.6;\">\n                            <p>{{ $json.body }}</p>\n                        </td>\n                    </tr>\n\n                    \n\n                    <!-- 10 Feature Cards Grid -->\n                    <tr>\n                        <td style=\"padding: 0 40px 40px 40px;\">\n                            <h3 style=\"color: #1e3a8a; font-size: 22px; font-weight: bold; margin-bottom: 25px; text-align: center;\">Our Core Service Offerings</h3>\n\n                            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" role=\"presentation\">\n                                <tr>\n                                    <td>\n                                        <!-- Main Card Grid Table (5 Rows, 2 Columns) -->\n                                        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" role=\"presentation\">\n\n                                            <!-- Card Generation Macro (5 rows of 2 cards each for 10 cards) -->\n\n                                            <!-- ROW 1 (Cards 1 & 2) -->\n                                            <tr>\n                                                <!-- Card 1 -->\n                                                <td class=\"stack-col\" width=\"50%\" valign=\"top\" style=\"padding-right: 10px; padding-bottom: 20px;\">\n                                                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" role=\"presentation\" style=\"background-color: #f3f4f6; border-radius: 8px;\">\n                                                        <tr><td style=\"padding: 15px;\">\n                                                            <p style=\"font-size: 16px; font-weight: bold; color: #1f2937; margin: 0 0 5px 0;\">\n                                                                ⚙️ {{ $json.services[0].service }}\n                                                            </p>\n                                                            <p style=\"font-size: 13px; color: #4b5563; margin-bottom: 10px; line-height: 1.4;\">\n                                                                {{ $json.services[0].description }}\n                                                            </p>\n                                                        </td></tr>\n                                                    </table>\n                                                </td>\n                                                <!-- Card 2 -->\n                                                <td class=\"stack-col\" width=\"50%\" valign=\"top\" style=\"padding-left: 10px; padding-bottom: 20px;\">\n                                                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" role=\"presentation\" style=\"background-color: #f3f4f6; border-radius: 8px;\">\n                                                         <tr><td style=\"padding: 15px;\">\n                                                            <p style=\"font-size: 16px; font-weight: bold; color: #1f2937; margin: 0 0 5px 0;\">\n                                                                🛡️ {{ $json.services[1].service }}\n                                                            </p>\n                                                            <p style=\"font-size: 13px; color: #4b5563; margin-bottom: 10px; line-height: 1.4;\">\n                                                                {{ $json.services[1].description }}\n                                                            </p>\n                                                        </td></tr>\n                                                    </table>\n                                                </td>\n                                            </tr>\n\n                                          <tr>\n                                                <!-- Card 1 -->\n                                                <td class=\"stack-col\" width=\"50%\" valign=\"top\" style=\"padding-right: 10px; padding-bottom: 20px;\">\n                                                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" role=\"presentation\" style=\"background-color: #f3f4f6; border-radius: 8px;\">\n                                                        <tr><td style=\"padding: 15px;\">\n                                                            <p style=\"font-size: 16px; font-weight: bold; color: #1f2937; margin: 0 0 5px 0;\">\n                                                                ⚙️ {{ $json.services[2].service }}\n                                                            </p>\n                                                            <p style=\"font-size: 13px; color: #4b5563; margin-bottom: 10px; line-height: 1.4;\">\n                                                                {{ $json.services[2].description }}\n                                                            </p>\n                                                        </td></tr>\n                                                    </table>\n                                                </td>\n                                                <!-- Card 2 -->\n                                                <td class=\"stack-col\" width=\"50%\" valign=\"top\" style=\"padding-left: 10px; padding-bottom: 20px;\">\n                                                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" role=\"presentation\" style=\"background-color: #f3f4f6; border-radius: 8px;\">\n                                                         <tr><td style=\"padding: 15px;\">\n                                                            <p style=\"font-size: 16px; font-weight: bold; color: #1f2937; margin: 0 0 5px 0;\">\n                                                                🛡️ {{ $json.services[3].service }}\n                                                            </p>\n                                                            <p style=\"font-size: 13px; color: #4b5563; margin-bottom: 10px; line-height: 1.4;\">\n                                                                {{ $json.services[3].description }}\n                                                            </p>\n                                                        </td></tr>\n                                                    </table>\n                                                </td>\n                                            </tr>\n\n                                           \n\n                                        </table>\n                                    </td>\n                                </tr>\n                            </table>\n                        </td>\n                    </tr>\n                    <!-- End 10 Feature Cards Grid -->\n\n                    <!-- Footer Section (Dark Blue) -->\n                    <tr>\n                        <td style=\"padding: 30px 40px; background-color: #1e3a8a; border-radius: 0 0 12px 12px; color: #e0e7ff; text-align: center;\">\n                            <div style=\"font-size: 12px; margin: 0 0 10px 0;\">{{ $('Generate Email Webhook').item.json.body.ownerProfile.signatureHtml }}</div>\n                            <p style=\"font-size: 11px; color: #93c5fd; margin-top: 15px; margin-bottom: 0;\">\n                                &copy; 2025. All rights reserved. <a href=\"{{ 'https://api.myn8n.au/api/public/unsubscribe?businessId=' + $json.businessId }}\"\n style=\"color: #93c5fd;\">Unsubscribe</a>\n                            </p>\n                        </td>\n                    </tr>\n                </table>\n                <!-- End Main Content Wrapper -->\n\n            </td>\n        </tr>\n    </table>\n    <!-- End Outer Table -->\n\n</body>\n</html>"
      },
