      "id": "ec602408-c11d-4ad9-bb87-e0075cd4b738",
      "name": "Email generation"
    },
    {
      "parameters": {
        "jsCode": "const raw = $('Email generation').first().json.text;\n\n// Strip the markdown fences first\nconst cleaned = raw\n  .replace(/^```json\\s*/i, '')\n  .replace(/```\\s*$/i, '')\n  .trim();\n\nconst parsed = JSON.parse(cleaned);\n\nconst specialisedBody = parsed.Specialisation;\nconst specialsedLowerCase = specialisedBody.toLowerCase();\n\nconst findSpecialisation = (specialisedGeneral) => {\n  if (specialisedGeneral.includes(\"dentist\") || specialisedGeneral.includes(\"dental\")) {\n    return \"https://carbonelle.s3.ap-southeast-2.amazonaws.com/images/Dentist.png\";\n  } else if (specialisedGeneral.includes(\"dermatologist\") || specialisedGeneral.includes(\"dermatology\")) {\n    return \"https://carbonelle.s3.ap-southeast-2.amazonaws.com/images/Dermatology.png\";\n  } else {\n    return \"https://carbonelle.s3.ap-southeast-2.amazonaws.com/images/GP.png\";\n  }\n};\n\nconst rawServices = $('Generate Email Webhook').item.json.body.ownerProfile?.services || [];\nconst services = [0, 1, 2, 3].map((i) => rawServices[i] || { service: '', description: '' });\n\nreturn [{\n  json: {\n    subject: parsed.subject,\n    body: parsed.body,\n    services,\n    imageLink: findSpecialisation(specialsedLowerCase),\n    email: parsed.email,\n    businessId: $('Generate Email Webhook').item.json.body.business.id,\n    servicesIntro: parsed.servicesIntro,\n    preheader: parsed.preheader\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        352
      ],
      "id": "90aa8dec-f447-44b6-8af5-e14ab16effc3",
      "name": "Parsing Data"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text;\n\n// Step 1: Remove the ```json at the start and ``` at the end\nconst cleaned = raw\n  .replace(/^```json\\s*/i, '')   // Remove opening ```json\n  .replace(/```\\s*$/i, '')       // Remove closing ```\n  .trim();                        // Remove any extra whitespace\n\n// Step 2: Now it's safe to parse\nconst parsed = JSON.parse(cleaned);\n\n// Strip any % the LLM may have added — the HTML template appends its own\nconst discountPercentage = String(parsed.Percentage).replace(/%/g, '').trim();\n\nconst rawServices = $('Generate Email Webhook').item.json.body.ownerProfile?.services || [];\nconst services = [0, 1, 2, 3].map((i) => rawServices[i] || { service: '', description: '' });\n\nreturn [{\n  json: {\n    subject: parsed.subject,\n    body: parsed.body,\n    email: parsed.email,\n    services,\n    offerPeriod: parsed.OfferTime,\n    DiscountPercentage: discountPercentage,\n    businessId: $('Generate Email Webhook').item.json.body.business.id\n  }\n}];"
      },
