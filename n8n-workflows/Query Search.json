      ],
      "id": "abafc05b-8227-4044-b59f-e40d973ab581",
      "name": "Firecrawl Search",
      "retryOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "eWufcyvisZkqmLkT",
          "name": "firecrawl api"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Get the input data from the previous node\nconst input = $input.first().json;\n\n// Case 1: Firecrawl failed (came through the error output)\nif (input.error) {\n  return [{\n    json: {\n      url: null,\n      title: null,\n      failed: true,\n      errorMessage: input.error.message || \"Firecrawl request failed\"\n    }\n  }];\n}\n\n// Case 2: Firecrawl succeeded, but returned no results\nconst webArray = input.data?.web;\nif (!webArray || webArray.length === 0) {\n  return [{\n    json: {\n      url: null,\n      title: null,\n      failed: true,\n      errorMessage: \"No results found\"\n    }\n  }];\n}\n\n// Case 3: Normal success — map url and title as before\nreturn webArray.map(entry => ({\n  json: {\n    url: entry.url,\n    title: entry.title,\n    failed: false\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
