    {
      "parameters": {
        "jsCode": "// Collect all items and build the callback payload\nconst allItems = $input.all();\n\n// Separate successful items from failed ones\nconst successfulItems = allItems.filter(item => !item.json.failed);\nconst failedItems = allItems.filter(item => item.json.failed);\n\nconst results = successfulItems.map(item => ({\n  url: item.json.url,\n  businessName: item.json.title\n}));\n\n// Grab queryId from the original webhook body\nconst queryId = $('Webhook').first().json.body.queryId;\n\n// Build the base payload\nconst payload = {\n  queryId,\n  results\n};\n\n// If there are no successful results, attach an explanation\nif (results.length === 0) {\n  payload.error = failedItems.length > 0\n    ? (failedItems[0].json.errorMessage || \"Search failed\")\n    : \"No results found\";\n}\n\nreturn [{\n  json: payload\n}];"
      },
