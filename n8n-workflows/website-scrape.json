    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a data extraction assistant.\n\nGoal:\nFrom the given markdown text {{ $json.data.markdown }}, extract structured business information. \n\nFields to extract (leave blank or null if not present):\n- name (the business name)\n- specialisation (type of business, e.g., dental clinic, medical centre, physiotherapist, GP, etc.)\n- location (address, suburb, or city — whichever is available)\n- phone (official contact numbers, comma separated if there are many)\n- email (official contact email)\n- yearsExperience (if explicitly mentioned, e.g., \"over 10 years of experience\")\n- services (main services or treatments, comma-separated)\n- awards (awards, recognitions, certifications, AND notable achievements — combine all of these into this single field)\n\nInstructions:\n1. Keep your output only based on the provided markdown — do not assume, guess, or invent information.\n2. If {{ $json.sucess }} = false, then for every values of attributes in output json put, {{ $json.code }}.\n\n",
        "hasOutputParser": true,
        "messages": {
          "messageValues": []
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        224,
        496
      ],
      "id": "f9bd6470-0f1d-4563-8635-fdaef6738873",
      "name": "AI Extract Business Data",
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"name\": \"ABC Clinic\",\n  \"specialisation\": \"Dental Clinic\",\n  \"location\": \"Sydney, NSW\",\n  \"phone\": \"\",\n  \"email\": \"contact@abcclinic.com\",\n  \"yearsExperience\": \"10+\",\n  \"services\": \"Teeth Whitening, Root Canal, Orthodontics\",\n  \"awards\": \"Best Dental Clinic 2022; Certified Invisalign Provider\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
