    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a data extraction assistant.\n\nGoal:\nFrom the given markdown text {{ $json.data.markdown }}, extract structured business information. \n\nFields to extract (leave as an empty string \"\" if not present — never output null; the schema requires every field to be a string):\n- name (the business name)\n- specialisation (type of business, e.g., dental clinic, medical centre, physiotherapist, GP, etc.)\n- location (address, suburb, or city — whichever is available)\n- phone (official contact numbers, comma separated if there are many)\n- email (official contact email)\n- yearsExperience (if explicitly mentioned, e.g., \"over 10 years of experience\")\n- services (main services or treatments, comma-separated)\n- awards (awards, recognitions, certifications, AND notable achievements — combine all of these into this single field)\n\nInstructions:\n1. Keep your output only based on the provided markdown — do not assume, guess, or invent information.\n2. Respond with ONLY the JSON object matching the required schema — no extra commentary, no markdown code fences, and every field must be a plain string (not an array, not an object, and never null — use \"\" instead), even for multi-item fields like services or awards.\n3. The fields (name, specialisation, location, phone, email, yearsExperience, services, awards) must be top-level keys in the JSON object itself — do not nest them under \"output\" or any other wrapper key.\n\n",
        "hasOutputParser": true,
        "messages": {
          "messageValues": []
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        368,
        336
      ],
      "id": "69009d5d-3ec0-402d-b03e-4989d777a6f5",
      "name": "AI Extract Business Data",
      "retryOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"name\": \"ABC Clinic\",\n  \"specialisation\": \"Dental Clinic\",\n  \"location\": \"Sydney, NSW\",\n  \"phone\": \"\",\n  \"email\": \"contact@abcclinic.com\",\n  \"yearsExperience\": \"10+\",\n  \"services\": \"Teeth Whitening, Root Canal, Orthodontics\",\n  \"awards\": \"Best Dental Clinic 2022; Certified Invisalign Provider\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        504,
        560
      ],
      "id": "c109367b-6c43-4316-bf01-1d2d1eac39f9",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst sourceRow = $('Split the body into separate Items').item.json;\n\nif (input.error) {\n  return [{\n    json: {\n      queryResultId: sourceRow.id,\n      name: 'SCRAPE_EXTRACTION_ERROR',\n      specialisation: 'SCRAPE_EXTRACTION_ERROR',\n      location: 'SCRAPE_EXTRACTION_ERROR',\n      phone: 'SCRAPE_EXTRACTION_ERROR',\n      email: 'SCRAPE_EXTRACTION_ERROR',\n      yearsExperience: 'SCRAPE_EXTRACTION_ERROR',\n      services: 'SCRAPE_EXTRACTION_ERROR',\n      awards: 'SCRAPE_EXTRACTION_ERROR'\n    }\n  }];\n}\n\nconst extracted = input.output;\nreturn [{\n  json: {\n    queryResultId: sourceRow.id,\n    url: sourceRow.url,\n    ...extracted\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        660
      ],
