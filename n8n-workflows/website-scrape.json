      ],
      "id": "1c51f376-ef30-45af-a5cb-9a35e5b03fbf",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const extracted = $input.first().json.output;\nconst queryResultId = $('Split the body into separate Items').item.json.id;\nreturn [{\n  json: {\n    queryResultId,\n    ...extracted\n  }\n}];"
