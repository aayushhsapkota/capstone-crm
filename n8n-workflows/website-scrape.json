    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a data extraction assistant.\n\nGoal:\nFrom the given markdown text {{ $json.data.markdown }}, extract structured business information. \n\nFields to extract (leave as an empty string \"\" if not present — never output null; the schema requires every field to be a string):\n- name (the business name)\n- specialisation (type of business, e.g., dental clinic, medical centre, physiotherapist, GP, etc.)\n- location (address, suburb, or city — whichever is available)\n- phone (official contact numbers, comma separated if there are many)\n- email (official contact email)\n- yearsExperience (if explicitly mentioned, e.g., \"over 10 years of experience\")\n- services (main services or treatments, comma-separated)\n- awards (awards, recognitions, certifications, AND notable achievements — combine all of these into this single field)\n\nInstructions:\n1. Keep your output only based on the provided markdown — do not assume, guess, or invent information.\n2. Respond with ONLY the JSON object matching the required schema — no extra commentary, no markdown code fences, and every field must be a plain string (not an array, not an object, and never null — use \"\" instead), even for multi-item fields like services or awards.\n3. Return only JSON in this exact shape, with everything nested inside an output key:\n{\"output\": {\"name\": \"...\", \"specialisation\": \"...\", \"location\": \"...\", \"phone\": \"...\", \"email\": \"...\", \"yearsExperience\": \"...\", \"services\": \"...\", \"awards\": \"...\"}}\n",
        "hasOutputParser": true,
        "messages": {
          "messageValues": []
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        448,
        752
      ],
      "id": "47c92d2b-a98e-4c1a-bdb9-79d8ddafc4be",
      "name": "AI Extract Business Data",
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"output\": {\n    \"name\": \"ABC Clinic\",\n    \"specialisation\": \"Dental Clinic\",\n    \"location\": \"Sydney, NSW\",\n    \"phone\": \"(02) 9232 2311\",\n    \"email\": \"contact@abcclinic.com\",\n    \"yearsExperience\": \"10+\",\n    \"services\": \"Teeth Whitening, Root Canal, Orthodontics\",\n    \"awards\": \"Best Dental Clinic 2022; Certified Invisalign Provider\"\n  }\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        592,
        960
      ],
      "id": "84e70f0b-31b6-4470-9490-d22e3f00768d",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst sourceRow = $('Split the body into separate Items').first().json;\nif (input.error) {\n  return [{\n    json: {\n      queryResultId: sourceRow.id,\n      name: 'SCRAPE_EXTRACTION_ERROR',\n      specialisation: 'SCRAPE_EXTRACTION_ERROR',\n      location: 'SCRAPE_EXTRACTION_ERROR',\n      phone: 'SCRAPE_EXTRACTION_ERROR',\n      email: 'SCRAPE_EXTRACTION_ERROR',\n      yearsExperience: 'SCRAPE_EXTRACTION_ERROR',\n      services: 'SCRAPE_EXTRACTION_ERROR',\n      awards: 'SCRAPE_EXTRACTION_ERROR'\n    }\n  }];\n}\n\nconst extracted = input.output;\nreturn [{\n  json: {\n    queryResultId: sourceRow.id,\n    url: sourceRow.url,\n    ...extracted\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        1088
      ],
      "id": "356f9ae6-fc79-4912-9a27-13b4cbc85802",
      "name": "Attach queryResultId"
    },
