    },
    {
      "parameters": {
        "jsCode": "const extracted = $input.first().json.output;\nconst queryResultId = $('Split URLs into Items').item.json.id;\nreturn [{\n  json: {\n    queryResultId,\n    ...extracted\n  }\n}];"
      },
